# 依赖
node_modules/

# 微信开发者工具的本地私有配置（含个人设置，不应提交）
project.private.config.json
miniprogram/.wxssc/
miniprogram/miniprogram_npm/

# 云函数依赖
cloudfunctions/**/node_modules/
cloudfunctions/**/package-lock.json

# 构建产物与日志
dist/
*.log
npm-debug.log*

# Python 字节码（tools/ 下的脚本与测试会生成）
__pycache__/
*.pyc

# 编辑器
.vscode/
.idea/
.DS_Store
Thumbs.db

# Word 打开文档时生成的临时锁定文件
~$*.docx

# 敏感文件：账号级配置、密钥证书、数据库导出
*.env
.env
.env.*
cloudbaserc.json
.cloudbase/
*.pem
*.p12
*.key
*.cer
backup/

# 可重新生成的产物（跑一次命令就能重来，不入库）
/tools/test-report.xml
/tools/singles-experiment-*.json
/tools/_exp_stdout.txt

# 法务文书（授权委托书、著作权协议、个人信息协议、隐私政策等）
# 含个人身份信息、学校信息与签字页，只留在本地，不入库
/法务文书/

# 主体注册与商用路径备忘（法务决策文档，含个人信息与校内事项）
/docs/主体注册与商用路径备忘-*.md
/主体注册与商用路径备忘*.docx

# 小程序 AppID 与云开发环境 ID：账号级信息，只在本地填
# 拉下仓库后把同名 *.example.* 复制成正式文件即可
# 不锚定根目录，子目录里再出现同名文件也一并挡住
project.config.json
miniprogram/config.js
miniprogram/config.local.js

# 含真实联系方式或实验数据的表格，属个人资料，不入库
/未定产品决策跟踪表.xlsx
/单打评分实验记录*.xlsx

# 上一轮文档更新的副本，属可丢弃（正本在根目录）
/文档备份_更新前/

# 智能体的工作记忆（接手时的进度笔记），不入库
# 例外：.workbuddy/skills/ 是本项目的施工约定，属于交付物，必须入库
.workbuddy/*
!.workbuddy/skills/

# 建表脚本的工作目录（交付物已入库，脚本留本地备用）
.*.ref/

# 本地临时产物：配色 / 布局预览页与测试日志，跑一次就能重来
/state/
