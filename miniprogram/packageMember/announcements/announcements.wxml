<!--
  公告列表
  数据形状见 services/announcement-view.js 的 loadSchoolAnnouncementListView。
  这一页不判权限：视图模型给每行的 canArchive 恒为假，不会冒出管理按钮。

  公告是**本校一个通道**：没有协会标签，也没有「通知 / 赛事 / 战报」分类标签
   （2026-10-18 起只有管理员能发全校公告）。主题类由视图模型下发、挂在内容层，
   根节点保持中性，加载 / 出错态不随协会变色。
-->
<view class="page-container">

  <!-- 加载中。必须排在出错之前，否则首屏会一闪而过地报错 -->
  <view wx:if="{{loading}}" class="loading">正在加载…</view>

  <view wx:elif="{{error}}" class="empty-state">
    <view class="empty-state-icon">⚠️</view>
    <view class="empty-state-text">{{error}}</view>
  </view>

  <block wx:else>
    <view class="{{view.themeClass}}">

      <view wx:if="{{view.visibleCount === 0}}" class="card">
        <view class="empty-note">{{view.emptyText}}</view>
      </view>

      <view wx:else class="card">
        <view wx:for="{{view.rows}}" wx:for-item="notice" wx:key="id" id="notice-{{index}}" class="notice-row">
          <view class="notice-head">
            <text wx:if="{{notice.pinned}}" class="tag notice-pin">置顶</text>
            <text class="notice-date">{{notice.publishText}}</text>
          </view>
          <view class="notice-title" data-id="{{notice.id}}" bindtap="onToggleNotice">{{notice.title}}</view>
          <view class="notice-content {{expandedNotices[notice.id] ? 'is-expanded' : 'is-collapsed'}}">{{notice.content}}</view><button class="notice-expand" data-id="{{notice.id}}" bindtap="onToggleNotice">{{expandedNotices[notice.id] ? '收起正文' : '展开正文'}}</button>
        </view>
      </view>

      <view wx:if="{{view.total > 0}}" class="card-subtitle">已加载 {{view.rows.length}} / {{view.total}} 条</view>
      <view wx:if="{{moreError}}" class="pagination-error">{{moreError}}</view>
      <button wx:if="{{view.hasMore}}" class="btn btn-outline btn-block" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">{{moreError ? '重试加载' : '加载更多'}}</button>

      <view wx:if="{{isMock}}" class="mock-note">
        当前为本地模拟数据，用于开发预览
      </view>
    </view>
  </block>
</view>
